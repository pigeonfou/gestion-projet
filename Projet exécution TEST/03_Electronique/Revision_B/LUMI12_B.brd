    <board>
      <plain>
        <wire x1="0" y1="0" x2="40" y2="0" width="0.15" layer="20" />
        <wire x1="40" y1="0" x2="40" y2="25" width="0.15" layer="20" />
        <wire x1="40" y1="25" x2="0" y2="25" width="0.15" layer="20" />
