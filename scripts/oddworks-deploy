#!/usr/bin/env bash
# Root-owned helper: only full commit SHAs reachable from official main are accepted.
set -Eeuo pipefail
umask 027
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[[ $EUID -eq 0 && $# -eq 1 && $1 =~ ^[0-9a-f]{40}$ ]] || {
  echo 'Usage : sudo oddworks-deploy <SHA complet de main>' >&2; exit 2;
}
sha=$1
app=/opt/oneforall/apps/oddworks
db=/var/lib/oneforall/oddworks/database.sqlite
state=/var/lib/oddworks-deploy
repo=$state/repository.git
service=oneforall-oddworks-web.service
ip -4 -o addr show | grep -Eq 'inet 192[.]168[.]6[.]28/'
test -L "$app/current"
test -f "$db"
systemctl is-active --quiet "$service"
exec 9>"$state/deploy.lock"
flock -n 9 || { echo 'Un déploiement est déjà en cours.' >&2; exit 1; }
previous=$(readlink -f "$app/current")
[[ $previous == "$app/releases/"* && -d $previous ]] || exit 1
[[ -d $repo ]] || git init --bare "$repo" >/dev/null
git --git-dir="$repo" fetch --no-tags https://github.com/pigeonfou/gestion-projet.git \
  +refs/heads/main:refs/heads/approved-main
git --git-dir="$repo" merge-base --is-ancestor "$sha" refs/heads/approved-main
test "$(git --git-dir="$repo" cat-file -t "$sha")" = commit
release=$app/releases/$sha
stage=$(mktemp -d "$state/stage.XXXXXX")
backup=''
stopped=0
live=0
switched=0
snapshot_ready=0
cleanup() {
  result=$?
  trap - EXIT
  if (( result != 0 && stopped == 1 && live == 0 )); then
    # No requests were served by the new version: restore the consistent snapshot.
    if (( snapshot_ready == 1 )); then
      rm -f -- "$db-wal" "$db-shm"
      cp -- "$backup/database.sqlite" "$db"
      chown ofa-oddworks:ofa-oddworks "$db"
      chmod 0660 "$db"
    fi
    if (( switched == 1 )); then
      ln -s "$previous" "$app/current.recovery.$$"
      mv -Tf "$app/current.recovery.$$" "$app/current"
    fi
    systemctl start "$service" || true
  fi
  rm -rf -- "$stage"
  if (( result != 0 )); then
    echo "ÉCHEC. Version précédente : $previous ; sauvegarde : ${backup:-non créée}." >&2
    if (( live == 1 )); then
      echo 'Le service a été rouvert : aucune restauration automatique des données pour préserver les écritures éventuelles.' >&2
    fi
  fi
  exit "$result"
}
trap cleanup EXIT
git --git-dir="$repo" archive "$sha" | tar -x -C "$stage"
test -f "$stage/includes/schema.php"
test -f "$stage/login.php"
test -f "$stage/scripts/generate-cdc-msg.py"
test -f "$stage/requirements-cdc-msg.txt"
while IFS= read -r -d '' file; do php -l "$file" >/dev/null; done < <(find "$stage" -name '*.php' -print0)
# Prepare the isolated, non-networking .msg file writer before the brief PHP-FPM
# maintenance window. The runtime lives with application data, outside releases.
msg_runtime=/opt/oneforall/apps/oddworks/shared/cdc-msg-venv
if ! [[ -x "$msg_runtime/bin/python3" ]] || ! "$msg_runtime/bin/python3" -c 'import aspose.email_foss' >/dev/null 2>&1; then
  if ! python3 -m venv --help >/dev/null 2>&1; then
    apt-get update
    apt-get install -y python3-venv
  fi
  install -d -o root -g root -m 0755 "$(dirname "$msg_runtime")"
  if ! [[ -x "$msg_runtime/bin/python3" ]]; then
    python3 -m venv "$msg_runtime"
  fi
  "$msg_runtime/bin/python3" -m pip install --disable-pip-version-check --no-input -r "$stage/requirements-cdc-msg.txt"
  runuser -u ofa-oddworks -- "$msg_runtime/bin/python3" -c 'from aspose.email_foss.msg import MapiMessage; print("MSG runtime ready")' >/dev/null
fi
if [[ -e $release ]]; then
  diff -qr --exclude=.oddworks-release "$stage" "$release" >/dev/null
else
  install -d -o root -g root -m 0755 "$release"
  cp -a "$stage/." "$release/"
  chown -R root:root "$release"
  find "$release" -type d -exec chmod 0755 {} +
  find "$release" -type f -exec chmod 0644 {} +
fi
backup=/var/backups/oddworks/$(date -u +%Y%m%dT%H%M%SZ)-${sha:0:12}-$$
install -d -o root -g root -m 0700 "$backup"
printf '%s\n' "$previous" > "$backup/previous-release"
printf '%s\n' "$sha" > "$backup/target-commit"
systemctl stop "$service"
stopped=1
sqlite3 "$db" '.timeout 30000' ".backup '$backup/database.sqlite'"
test "$(sqlite3 "$backup/database.sqlite" 'PRAGMA integrity_check;')" = ok
snapshot_ready=1
runuser -u ofa-oddworks -- env PROJECTFLOW_DB_PATH="$db" PROJECTFLOW_BASE_PATH=/oddworks \
  php -r 'require $argv[1]; runSchemaMigrations();' "$release/includes/schema.php"
test "$(sqlite3 "$db" 'PRAGMA integrity_check;')" = ok
ln -s "$release" "$app/current.next.$$"
mv -Tf "$app/current.next.$$" "$app/current"
switched=1
# After start is attempted, HTTP requests could write; do not restore the DB automatically.
live=1
systemctl start "$service"
systemctl is-active --quiet "$service"
test "$(readlink -f "$app/current")" = "$release"
curl --fail --silent --show-error --max-time 20 --retry 3 --retry-delay 2 \
  -H 'Host: www.pigeonfou.com' http://127.0.0.1:18080/oddworks/login.php \
  | grep -F '<title>Connexion - OddWorks</title>' >/dev/null
printf '%s\n' "$sha" > "$state/installed-commit"
echo "OddWorks installé : $sha"
echo "Sauvegarde SQLite : $backup/database.sqlite"
echo "Version précédente conservée : $previous"
